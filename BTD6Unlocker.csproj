<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>BTD6Unlocker</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Nullable>enable</Nullable>
        <AssemblyName>BTD6Unlocker</AssemblyName>
        <LangVersion>preview</LangVersion>
        <Optimize>False</Optimize>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!--
      Modern BTD6 mods no longer hand-reference MelonLoader/Il2CppInterop/Btd6ModHelper DLLs via
      hardcoded HintPaths. Mod Helper generates a btd6.targets file (via the "BTD6 Mod Sources"
      folder it creates in your Documents directory) that resolves all of those references for you
      based on your local BloonsTD6 install, and understands Debug (copies to /Mods, unpacked) vs
      Release (embeds dependencies) builds.

      For this to resolve, this project must live one folder below btd6.targets - normally that
      means moving/cloning this repo into:
        Documents/BTD6 Mod Sources/BTD6Unlocker/BTD6Unlocker.csproj
      with Documents/BTD6 Mod Sources/btd6.targets alongside it (auto-generated once Mod Helper is
      installed and BTD6 has been launched at least once).

      For CI (no local game install), see doombubbles/btd6-template-mod's
      .github/workflows/build.yml: it downloads MelonLoader + btd6-ci-dependencies (Il2Cpp
      assemblies) + the Btd6ModHelper.dll release, plus a fresh copy of btd6.targets, into a sibling
      "BloonsTD6" folder, then runs `dotnet build -p:BloonsTD6="../BloonsTD6" BTD6Unlocker.csproj`.
    -->
    <Import Project="..\btd6.targets" />
</Project>
